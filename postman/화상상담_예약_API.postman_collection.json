{
  "info": {
    "_postman_id": "5ecf8597-852d-49e1-b4e0-8495b8baf443",
    "name": "화상상담 예약 API",
    "description": "화상상담 예약 API의 인증, 일정 조회, 생성·변경·취소, 충돌, 입력값, 시간 경계 및 동시성을 검증합니다. 00~03 폴더는 순서대로 자동 실행할 수 있고 04~05는 별도 데이터가 있을 때 선택 실행합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('[공통] Content-Type은 JSON이다', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "pm.test('[공통] 공통 응답 형식을 따른다', function () {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.have.all.keys('isSuccess', 'timestamp', 'code', 'httpStatus', 'message', 'data');",
          "    pm.expect(body.httpStatus).to.eql(pm.response.code);",
          "    pm.expect(body.isSuccess).to.eql(pm.response.code < 400);",
          "});",
          "pm.test('[공통] 응답 시간이 기준 이내다', function () {",
          "    const limit = Number(pm.environment.get('maxResponseTimeMs') || 3000);",
          "    pm.expect(pm.response.responseTime).to.be.below(limit);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00. 인증 준비",
      "description": "환자 접근 링크를 발급·검증하고 이후 요청에서 사용할 JWT를 환경변수에 저장합니다.",
      "item": [
        {
          "name": "01. 환자 접근 링크 생성",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"expiresInMinutes\": 60\n}" },
            "url": { "raw": "{{baseUrl}}/patients/{{patientId}}/access-links", "host": ["{{baseUrl}}"], "path": ["patients", "{{patientId}}", "access-links"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('접근 링크가 생성된다', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(body.code).to.eql('GLOBAL_201');",
              "    pm.expect(body.data.patientId).to.eql(Number(pm.environment.get('patientId')));",
              "    pm.expect(body.data.token).to.be.a('string').and.not.empty;",
              "});",
              "if (pm.response.code === 201 && body.data && body.data.token) pm.environment.set('accessLinkToken', body.data.token);"
            ] }
          }]
        },
        {
          "name": "02. 접근 링크 검증 및 JWT 저장",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{accessLinkToken}}\",\n  \"birthDate\": \"{{patientBirthDate}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/patients/access-links/verify", "host": ["{{baseUrl}}"], "path": ["patients", "access-links", "verify"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('환자 인증에 성공한다', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.code).to.eql('GLOBAL_200');",
              "    pm.expect(body.data.patientId).to.eql(Number(pm.environment.get('patientId')));",
              "    pm.expect(body.data.accessToken).to.be.a('string').and.not.empty;",
              "});",
              "if (pm.response.code === 200 && body.data && body.data.accessToken) pm.environment.set('accessToken', body.data.accessToken);"
            ] }
          }]
        }
      ]
    },
    {
      "name": "01. 예약 가능 일정 조회",
      "description": "테스트 월의 첫 예약 가능 날짜와 가용 슬롯 2개를 자동 선택합니다.",
      "item": [
        {
          "name": "01. 예약 가능 날짜 조회 및 날짜 저장",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments/available-dates?year={{testYear}}&month={{testMonth}}",
              "host": ["{{baseUrl}}"], "path": ["appointments", "available-dates"],
              "query": [{ "key": "year", "value": "{{testYear}}" }, { "key": "month", "value": "{{testMonth}}" }]
            }
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const now = new Date();",
              "if (!pm.environment.get('testYear')) pm.environment.set('testYear', String(now.getUTCFullYear()));",
              "if (!pm.environment.get('testMonth')) pm.environment.set('testMonth', String(now.getUTCMonth() + 1));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('예약 가능 날짜가 조회된다', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.code).to.eql('GLOBAL_200');",
              "    pm.expect(body.data).to.be.an('array').that.is.not.empty;",
              "    body.data.forEach(v => { pm.expect(v.date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); pm.expect(v.availableCount).to.be.above(0); });",
              "    const dates = body.data.map(v => v.date);",
              "    pm.expect(dates).to.eql([...dates].sort());",
              "});",
              "if (pm.response.code === 200 && body.data && body.data.length) pm.environment.set('appointmentDate', body.data[0].date);"
            ] } }
          ]
        },
        {
          "name": "02. 예약 가능 시간 조회 및 슬롯 저장",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments/available-slots?date={{appointmentDate}}",
              "host": ["{{baseUrl}}"], "path": ["appointments", "available-slots"],
              "query": [{ "key": "date", "value": "{{appointmentDate}}" }]
            }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "const available = body.data && body.data.slots ? body.data.slots.filter(v => v.available) : [];",
            "pm.test('예약 가능한 슬롯이 2개 이상 조회된다', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(body.code).to.eql('GLOBAL_200');",
            "    pm.expect(body.data.date).to.eql(pm.environment.get('appointmentDate'));",
            "    pm.expect(body.data.availableCount).to.eql(available.length);",
            "    pm.expect(available.length, '생성·변경 테스트에 미래 가용 슬롯 2개가 필요합니다').to.be.at.least(2);",
            "    const starts = body.data.slots.map(v => v.startsAt);",
            "    pm.expect(starts).to.eql([...starts].sort());",
            "});",
            "if (available.length >= 2) { pm.environment.set('slotId', String(available[0].slotId)); pm.environment.set('alternateSlotId', String(available[1].slotId)); }"
          ] } }]
        }
      ]
    },
    {
      "name": "02. 예약 생명주기 및 충돌",
      "description": "활성 예약이 없는 상태에서 순서대로 실행합니다. 마지막 요청에서 생성한 예약을 정리합니다.",
      "item": [
        {
          "name": "01. 예약 전 조회 - 없음",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/appointments?caseId={{caseId}}", "host": ["{{baseUrl}}"], "path": ["appointments"], "query": [{ "key": "caseId", "value": "{{caseId}}" }] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('활성 예약이 없다', function () { pm.response.to.have.status(200); pm.expect(body.code).to.eql('GLOBAL_200'); pm.expect(body.data.hasAppointment).to.eql(false); pm.expect(body.data.appointment).to.eql(null); });"
          ] } }]
        },
        {
          "name": "02. 예약 생성",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"caseId\": {{caseId}},\n  \"slotId\": {{slotId}}\n}" },
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('예약이 생성된다', function () {",
            "    pm.response.to.have.status(201);",
            "    pm.expect(body.code).to.eql('GLOBAL_201');",
            "    pm.expect(body.data.appointmentId).to.be.a('number');",
            "    pm.expect(body.data.caseId).to.eql(Number(pm.environment.get('caseId')));",
            "    pm.expect(body.data.slotId).to.eql(Number(pm.environment.get('slotId')));",
            "    ['startsAt','endsAt','waitingRoomOpensAt','waitingRoomClosesAt','timezoneId'].forEach(k => pm.expect(body.data[k]).to.exist);",
            "    pm.expect(body.data.canEnterWaitingRoom).to.be.a('boolean');",
            "});",
            "if (pm.response.code === 201 && body.data) pm.environment.set('appointmentId', String(body.data.appointmentId));"
          ] } }]
        },
        {
          "name": "03. 동일 케이스 중복 예약 거부",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"caseId\": {{caseId}},\n  \"slotId\": {{alternateSlotId}}\n}" },
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('활성 예약 중복을 거부한다', function () { pm.response.to.have.status(409); pm.expect(body.code).to.eql('APPOINTMENT_409_2'); });"
          ] } }]
        },
        {
          "name": "04. 이미 예약된 슬롯 사용 거부",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"caseId\": {{otherCaseId}},\n  \"slotId\": {{slotId}}\n}" },
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('예약된 슬롯을 거부한다', function () { pm.response.to.have.status(409); pm.expect(body.code).to.eql('APPOINTMENT_409_1'); });"
          ] } }]
        },
        {
          "name": "05. 동일 슬롯 변경 - 멱등 성공",
          "request": {
            "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"slotId\": {{slotId}}\n}" },
            "url": { "raw": "{{baseUrl}}/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["appointments", "{{appointmentId}}"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('같은 슬롯 변경은 멱등 처리된다', function () { pm.response.to.have.status(200); pm.expect(body.data.appointmentId).to.eql(Number(pm.environment.get('appointmentId'))); pm.expect(body.data.slotId).to.eql(Number(pm.environment.get('slotId'))); });"
          ] } }]
        },
        {
          "name": "06. 존재하지 않는 슬롯으로 변경 거부",
          "request": {
            "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"slotId\": 999999999\n}" },
            "url": { "raw": "{{baseUrl}}/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["appointments", "{{appointmentId}}"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('없는 슬롯 변경을 거부한다', function () { pm.response.to.have.status(404); pm.expect(body.code).to.eql('APPOINTMENT_404_2'); });"
          ] } }]
        },
        {
          "name": "07. 예약 시간 변경",
          "request": {
            "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"slotId\": {{alternateSlotId}}\n}" },
            "url": { "raw": "{{baseUrl}}/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["appointments", "{{appointmentId}}"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('예약 슬롯이 변경된다', function () { pm.response.to.have.status(200); pm.expect(body.code).to.eql('GLOBAL_200'); pm.expect(body.data.appointmentId).to.eql(Number(pm.environment.get('appointmentId'))); pm.expect(body.data.slotId).to.eql(Number(pm.environment.get('alternateSlotId'))); });"
          ] } }]
        },
        {
          "name": "08. 변경된 예약 조회",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/appointments?caseId={{caseId}}", "host": ["{{baseUrl}}"], "path": ["appointments"], "query": [{ "key": "caseId", "value": "{{caseId}}" }] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('변경 결과가 조회에 반영된다', function () { pm.response.to.have.status(200); pm.expect(body.data.hasAppointment).to.eql(true); pm.expect(body.data.appointment.appointmentId).to.eql(Number(pm.environment.get('appointmentId'))); pm.expect(body.data.appointment.slotId).to.eql(Number(pm.environment.get('alternateSlotId'))); });"
          ] } }]
        },
        {
          "name": "09. 예약 취소",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["appointments", "{{appointmentId}}"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('예약이 취소된다', function () { pm.response.to.have.status(200); pm.expect(body.code).to.eql('GLOBAL_200'); pm.expect(body.data).to.eql(null); });"
          ] } }]
        },
        {
          "name": "10. 취소된 예약 재취소 거부",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["appointments", "{{appointmentId}}"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('없는 예약 취소를 거부한다', function () { pm.response.to.have.status(404); pm.expect(body.code).to.eql('APPOINTMENT_404_1'); });"
          ] } }]
        },
        {
          "name": "11. 취소 후 조회 - 없음",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/appointments?caseId={{caseId}}", "host": ["{{baseUrl}}"], "path": ["appointments"], "query": [{ "key": "caseId", "value": "{{caseId}}" }] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('취소 후 활성 예약이 없다', function () { pm.response.to.have.status(200); pm.expect(body.data.hasAppointment).to.eql(false); pm.expect(body.data.appointment).to.eql(null); });"
          ] } }]
        }
      ]
    },
    {
      "name": "03. 인증 및 입력값 검증",
      "item": [
        {
          "name": "01. 인증 헤더 누락",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/appointments?caseId={{caseId}}", "host": ["{{baseUrl}}"], "path": ["appointments"], "query": [{ "key": "caseId", "value": "{{caseId}}" }] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('인증이 필요한 요청이다', function () { pm.response.to.have.status(401); pm.expect(body.code).to.eql('GLOBAL_401_1'); });"
          ] } }]
        },
        {
          "name": "02. 유효하지 않은 JWT",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "invalid.jwt.token", "type": "string" }] },
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/appointments?caseId={{caseId}}", "host": ["{{baseUrl}}"], "path": ["appointments"], "query": [{ "key": "caseId", "value": "{{caseId}}" }] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('잘못된 JWT를 거부한다', function () { pm.response.to.have.status(401); pm.expect(body.code).to.eql('GLOBAL_401_3'); });"
          ] } }]
        },
        {
          "name": "03. 허용 범위를 벗어난 월",
          "description": "현재 구현에서 500이 반환되면 메서드 파라미터 검증 예외의 전역 매핑 누락을 의미합니다.",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/appointments/available-dates?year=2026&month=13", "host": ["{{baseUrl}}"], "path": ["appointments", "available-dates"], "query": [{ "key": "year", "value": "2026" }, { "key": "month", "value": "13" }] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('월 범위 오류는 400으로 처리된다', function () { pm.response.to.have.status(400); pm.expect(body.isSuccess).to.eql(false); pm.expect(body.code).to.match(/^GLOBAL_400/); });"
          ] } }]
        },
        {
          "name": "04. 잘못된 날짜 형식",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/appointments/available-slots?date=2026-99-99", "host": ["{{baseUrl}}"], "path": ["appointments", "available-slots"], "query": [{ "key": "date", "value": "2026-99-99" }] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('날짜 형식 오류를 거부한다', function () { pm.response.to.have.status(400); pm.expect(body.code).to.eql('GLOBAL_400_2'); });"
          ] } }]
        },
        {
          "name": "05. 유효하지 않은 요청 바디",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"caseId\": {{caseId}},\n  \"slotId\": 0\n}" },
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('양수가 아닌 슬롯 ID를 거부한다', function () { pm.response.to.have.status(400); pm.expect(body.code).to.eql('GLOBAL_400_2'); });"
          ] } }]
        },
        {
          "name": "06. 존재하지 않는 슬롯으로 예약",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"caseId\": {{caseId}},\n  \"slotId\": 999999999\n}" },
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('없는 슬롯 예약을 거부한다', function () { pm.response.to.have.status(404); pm.expect(body.code).to.eql('APPOINTMENT_404_2'); });"
          ] } }]
        },
        {
          "name": "07. 존재하지 않는 예약 변경",
          "request": {
            "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"slotId\": {{slotId}}\n}" },
            "url": { "raw": "{{baseUrl}}/appointments/999999999", "host": ["{{baseUrl}}"], "path": ["appointments", "999999999"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('없는 예약 변경을 거부한다', function () { pm.response.to.have.status(404); pm.expect(body.code).to.eql('APPOINTMENT_404_1'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "04. 시간·권한 경계값 (선택)",
      "description": "관련 환경변수가 비어 있으면 자동으로 건너뜁니다.",
      "item": [
        {
          "name": "01. 지난 슬롯 예약 거부",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"caseId\": {{otherCaseId}},\n  \"slotId\": {{pastSlotId}}\n}" },
            "url": { "raw": "{{baseUrl}}/appointments", "host": ["{{baseUrl}}"], "path": ["appointments"] }
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["if (!pm.environment.get('pastSlotId')) pm.execution.skipRequest();"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('지난 슬롯을 거부한다', function () { pm.response.to.have.status(409); pm.expect(body.code).to.eql('APPOINTMENT_409_1'); });"] } }
          ]
        },
        {
          "name": "02. 상담 시작 후 예약 변경 거부",
          "request": {
            "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"slotId\": {{alternateSlotId}}\n}" },
            "url": { "raw": "{{baseUrl}}/appointments/{{startedAppointmentId}}", "host": ["{{baseUrl}}"], "path": ["appointments", "{{startedAppointmentId}}"] }
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["if (!pm.environment.get('startedAppointmentId')) pm.execution.skipRequest();"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('상담 시작 후 변경을 거부한다', function () { pm.response.to.have.status(409); pm.expect(body.code).to.eql('APPOINTMENT_409_3'); });"] } }
          ]
        },
        {
          "name": "03. 상담 시작 후 예약 취소 거부",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/appointments/{{startedAppointmentId}}", "host": ["{{baseUrl}}"], "path": ["appointments", "{{startedAppointmentId}}"] } },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["if (!pm.environment.get('startedAppointmentId')) pm.execution.skipRequest();"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('상담 시작 후 취소를 거부한다', function () { pm.response.to.have.status(409); pm.expect(body.code).to.eql('APPOINTMENT_409_3'); });"] } }
          ]
        },
        {
          "name": "04. 입장 가능 시간 밖 상담 입장 거부",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"PATIENT\",\n  \"agoraUid\": 10001,\n  \"userLanguage\": \"ko-KR\"\n}" },
            "url": { "raw": "{{baseUrl}}/consultations/{{outsideWindowAppointmentId}}/join", "host": ["{{baseUrl}}"], "path": ["consultations", "{{outsideWindowAppointmentId}}", "join"] }
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["if (!pm.environment.get('outsideWindowAppointmentId')) pm.execution.skipRequest();"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('입장 시간 밖 요청을 거부한다', function () { pm.response.to.have.status(403); pm.expect(body.code).to.eql('APPOINTMENT_403_1'); });"] } }
          ]
        },
        {
          "name": "05. 다른 환자의 케이스 예약 비노출",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{otherPatientAccessToken}}", "type": "string" }] },
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/appointments?caseId={{foreignCaseId}}", "host": ["{{baseUrl}}"], "path": ["appointments"], "query": [{ "key": "caseId", "value": "{{foreignCaseId}}" }] }
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["if (!pm.environment.get('otherPatientAccessToken') || !pm.environment.get('foreignCaseId')) pm.execution.skipRequest();"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('타 환자의 예약을 노출하지 않는다', function () { pm.response.to.have.status(200); pm.expect(body.data.hasAppointment).to.eql(false); pm.expect(body.data.appointment).to.eql(null); });"] } }
          ]
        }
      ]
    },
    {
      "name": "05. 동시성 (선택)",
      "description": "raceCaseId와 raceSlotId가 있을 때 동일 예약을 동시에 두 번 생성합니다. 성공한 예약은 수동으로 정리합니다.",
      "item": [
        {
          "name": "01. 동일 환자·케이스·슬롯 동시 예약",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/appointments?caseId={{raceCaseId}}", "host": ["{{baseUrl}}"], "path": ["appointments"], "query": [{ "key": "caseId", "value": "{{raceCaseId}}" }] } },
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "const hasRaceData = pm.environment.get('raceCaseId') && pm.environment.get('raceSlotId');",
                "if (!hasRaceData) {",
                "    pm.execution.skipRequest();",
                "} else {",
                "    const request = {",
                "        url: pm.environment.get('baseUrl') + '/appointments',",
                "        method: 'POST',",
                "        header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.environment.get('accessToken') },",
                "        body: { mode: 'raw', raw: JSON.stringify({ caseId: Number(pm.environment.get('raceCaseId')), slotId: Number(pm.environment.get('raceSlotId')) }) }",
                "    };",
                "    const results = [];",
                "    function verifyWhenDone() {",
                "        if (results.length !== 2) return;",
                "        const statuses = results.map(v => v.status).sort((a, b) => a - b);",
                "        const conflict = results.find(v => v.status === 409);",
                "        pm.test('동시 요청 중 정확히 한 건만 성공한다', function () { pm.expect(statuses).to.eql([201, 409]); });",
                "        pm.test('나머지 요청은 활성 예약 중복으로 거부된다', function () { pm.expect(conflict && conflict.code).to.eql('APPOINTMENT_409_2'); });",
                "    }",
                "    for (let i = 0; i < 2; i++) {",
                "        pm.sendRequest(request, function (error, response) {",
                "            pm.expect(error).to.eql(null);",
                "            let code = null;",
                "            try { code = response.json().code; } catch (e) {}",
                "            results.push({ status: response.code, code: code });",
                "            verifyWhenDone();",
                "        });",
                "    }",
                "}"
              ] }
            },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('동시 요청 후 활성 예약이 하나 존재한다', function () { pm.response.to.have.status(200); pm.expect(body.data.hasAppointment).to.eql(true); pm.expect(body.data.appointment.slotId).to.eql(Number(pm.environment.get('raceSlotId'))); });"
            ] } }
          ]
        }
      ]
    }
  ]
