# Agora 프로젝트 인증
agora.app-id=${AGORA_APP_ID}
agora.app-certificate=${AGORA_APP_CERTIFICATE}
agora.customer-id=${AGORA_CUSTOMER_ID}
agora.customer-secret=${AGORA_CUSTOMER_SECRET}

# RTC 토큰 만료 시간: 1시간
agora.token-expiration-seconds=${AGORA_TOKEN_EXPIRATION_SECONDS:3600}

# Agora Real-Time STT
agora.stt.base-url=${AGORA_STT_BASE_URL:https://api.agora.io/api/speech-to-text/v1}
agora.stt.sub-bot-uid=${AGORA_STT_SUB_BOT_UID:900001}
agora.stt.pub-bot-uid=${AGORA_STT_PUB_BOT_UID:900002}
agora.stt.max-idle-time-seconds=${AGORA_STT_MAX_IDLE_TIME_SECONDS:120}
agora.stt.keywords=리프팅,필러,보톡스,붓기,멍,염증,출혈

# UTC 저장
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

# 개발 단계에서만 사용하고 운영에서는 validate 또는 Flyway를 권장
spring.jpa.hibernate.ddl-auto=${JPA_DDL_AUTO:update}
