# Copy this file to application-secret.properties and replace every placeholder.
# application-secret.properties is already ignored by .gitignore.

DATABASE_URL=jdbc:mysql://localhost:3306/centerton?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DATABASE_USERNAME=replace-me
DATABASE_PASSWORD=replace-me

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRATION=3600000

CORS_ALLOWED_ORIGINS=http://localhost:5173

AGORA_APP_ID=replace-me
AGORA_APP_CERTIFICATE=replace-me
AGORA_CUSTOMER_ID=replace-me
AGORA_CUSTOMER_SECRET=replace-me
AGORA_TOKEN_EXPIRATION_SECONDS=3600
AGORA_STT_BASE_URL=https://api.agora.io/api/speech-to-text/v1
AGORA_STT_SUB_BOT_UID=900001
AGORA_STT_PUB_BOT_UID=900002
AGORA_STT_MAX_IDLE_TIME_SECONDS=120

# Optional comma-separated terms. Add this property only when needed.
# agora.stt.keywords=부기,출혈,고름,통증
